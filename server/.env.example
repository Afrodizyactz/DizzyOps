# Documentation only. Do not put real values in the repository.
NODE_ENV=production
PORT=8080
GOOGLE_CLOUD_PROJECT=
PUBLIC_ORIGIN=https://ops.afrodizzyacts.co.za
SAML_PROVIDER_ID=saml.afrodizzyacts

# Production flags default to off. Enable only after verified setup and review.
IDENTITY_PLATFORM_ENABLED=false
BUSINESS_API_ENABLED=false
FIRESTORE_DATABASE_ID=(default)

# Public web app identifiers (not signing keys).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Admin-approved staff email -> role map. Inject from Secret Manager, not GitHub.
# Roles: administrator, management, operations, finance, agent.
STAFF_ROLE_MAP_JSON={}
